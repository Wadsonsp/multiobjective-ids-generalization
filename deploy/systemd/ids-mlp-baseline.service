[Unit]
Description=Baseline da MLP conjunta com todos os atributos
StartLimitIntervalSec=0

[Service]
Type=exec
WorkingDirectory=%h/multiobjective-ids-generalization
ExecStart=%h/multiobjective-ids-generalization/.venv/bin/python -u src/executar_experimento_mlp.py --config %h/multiobjective-ids-generalization/src/config_mlp_conjunto.yaml --etapa baseline
Restart=on-failure
RestartSec=60
RestartPreventExitStatus=75
KillMode=control-group
TimeoutStopSec=60
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
Environment=MKL_NUM_THREADS=2
Environment=MPLBACKEND=Agg
StandardOutput=journal
StandardError=inherit

[Install]
WantedBy=default.target
